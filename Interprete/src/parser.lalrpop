use crate::ast::{BinaryOperator, EnumDefinition, EnumVariantDefinition, Expression, Function, Identity, IdentityItem, IntrospectionKind, Literal, MetadataEntry, MetadataValue, Mutability, Parameter, Program, ScalarSuffix, Statement, StructDefinition, StructField, SwitchCase, UnaryOperator, VariableDeclaration, VariableType};
use std::str::FromStr;

grammar;

pub Program: Program = {
    "env" "{" <environment:MetadataEntry*> "}"
    "capabilities" "{" <capabilities:MetadataEntry*> "}"
    <structs:StructDefinition*>
    <enums:EnumDefinition*>
    <identity:Identity>
    <top_functions:FunctionDefinition*>
    "fn" "main" "{" <main:Statement*> "}"
        => {
            let mut functions = identity.functions.clone();
            functions.extend(top_functions);
            Program { environment, capabilities, identity, structs, enums, functions, main }
        }
};

StructDefinition: StructDefinition = {
    "struct" <name:ID> "{" <fields:StructFieldList> "}" => StructDefinition { name, fields }
};

StructFieldList: Vec<StructField> = {
    => vec![],
    <first:StructField> <rest:("," <StructField>)*> => { let mut fields = vec![first]; fields.extend(rest); fields }
};

StructField: StructField = {
    <name:ID> ":" "let" <spec:DeclarationSpec> => StructField { name, mutability: spec.0, ty: spec.1 }
};

EnumDefinition: EnumDefinition = {
    "enum" <name:ID> "{" <variants:EnumVariantList> "}" => EnumDefinition { name, variants }
};

EnumVariantList: Vec<EnumVariantDefinition> = {
    <first:EnumVariantDefinition> <rest:("," <EnumVariantDefinition>)*> => { let mut variants = vec![first]; variants.extend(rest); variants }
};

EnumVariantDefinition: EnumVariantDefinition = {
    <name:ID> => EnumVariantDefinition { name, payload: vec![] },
    <name:ID> "(" <payload:TypeList> ")" => EnumVariantDefinition { name, payload }
};

TypeList: Vec<VariableType> = {
    => vec![],
    <first:TypeSpec> <rest:("," <TypeSpec>)*> => { let mut types = vec![first]; types.extend(rest); types }
};

FunctionDefinition: Function = {
    "fn" <name:ID> "(" <parameters:Parameters> ")" "->" <return_type:FunctionReturnType> "{" <body:Statement*> "}"
        => Function { name, parameters, return_type, body }
};

FunctionReturnType: Option<VariableType> = {
    "void" => None,
    <ty:TypeSpec> => Some(ty),
};

Parameters: Vec<Parameter> = {
    => vec![],
    <first:Parameter> <rest:("," <Parameter>)*> => {
        let mut parameters = vec![first];
        parameters.extend(rest);
        parameters
    }
};

Parameter: Parameter = {
    <name:ID> ":" <ty:TypeSpec> => Parameter { name, ty },
};

Identity: Identity = {
    "identity" "{" "name" ":" <name:StringValue> ";" <items:IdentityItems> "}"
        => {
            let mut variables = Vec::new();
            let mut functions = Vec::new();
            for item in items {
                match item {
                    IdentityItem::Variable(variable) => variables.push(variable),
                    IdentityItem::Function(function) => functions.push(function),
                }
            }
            Identity { name, variables, functions }
        }
};

IdentityItems: Vec<IdentityItem> = {
    <items:IdentityItem*> => items,
};

IdentityItem: IdentityItem = {
    <variable:VariableDeclaration> => IdentityItem::Variable(variable),
    <function:FunctionDefinition> => IdentityItem::Function(function),
};

MetadataEntry: MetadataEntry = {
    <key:ID> ":" <value:MetadataValue> ";" => MetadataEntry { key, value }
};

MetadataValue: MetadataValue = {
    <value:Literal> => MetadataValue::Literal(value),
    <identifier:ID> => MetadataValue::Identifier(identifier),
    "[" <values:MetadataValues> "]" => MetadataValue::Array(values),
};

MetadataValues: Vec<MetadataValue> = {
    => vec![],
    <first:MetadataValue> <rest:("," <MetadataValue>)*> => {
        let mut values = vec![first];
        values.extend(rest);
        values
    }
};

Statement: Statement = {
    <declaration:VariableDeclaration> => Statement::Variable(declaration),
    <name:ID> "=" <value:Expression> ";" => Statement::Assignment { name, value },
    <name:ID> "[" <index:Expression> "]" "=" <value:Expression> ";" => Statement::IndexAssignment { name, index, value },
    <base:ID> "." <field:ID> "=" <value:Expression> ";" => Statement::FieldAssignment { target: Expression::Field { value: Box::new(Expression::Variable(base)), name: field }, value },
    <base:ID> "[" <index:Expression> "]" "." <field:ID> "=" <value:Expression> ";" => Statement::FieldAssignment { target: Expression::Field { value: Box::new(Expression::Index { array: Box::new(Expression::Variable(base)), index: Box::new(index) }), name: field }, value },
    "display" "(" <arguments:DisplayArguments> ")" ";" => Statement::Display(arguments),
    "return" <value:Expression?> ";" => Statement::Return(value),
    <expression:FunctionCall> ";" => Statement::Expression(expression),
    "if" "(" <condition:Expression> ")" "{" <then_branch:Statement*> "}" <else_branch:("else" "{" <Statement*> "}")?> =>
        Statement::If { condition, then_branch, else_branch },
    "while" "(" <condition:Expression> ")" "{" <body:Statement*> "}" => Statement::While { condition, body },
    "repeat" "{" <body:Statement*> "}" "until" "(" <condition:Expression> ")" ";" => Statement::RepeatUntil { body, condition },
    "for" "(" <name:ID> "in" <start:Expression> ".." <end:Expression> ")" "{" <body:Statement*> "}" => Statement::ForRange { name, start, end, body },
    "for" "(" <name:ID> "in" <collection:Expression> ")" "{" <body:Statement*> "}" => Statement::ForEach { name, collection, body },
    <switch_statement:SwitchStatement> => switch_statement,
    "break" ";" => Statement::Break,
    "continue" ";" => Statement::Continue,
    "#" <name:ID> "{" <body:Statement*> "}" => Statement::Chunk { name, body },
};

SwitchStatement: Statement = {
    "switch" "(" <expression:Expression> ")" "{" <cases:SwitchCase*> "default" ":" <default_body:Statement*> "}" => {
        let mut cases = cases;
        cases.push(SwitchCase { enum_name: None, variant: None, bindings: vec![], body: default_body });
        Statement::Switch { expression, cases }
    }
};

SwitchCase: SwitchCase = {
    "case" <enum_name:ID> "::" <variant:ID> "(" <bindings:BindingList> ")" ":" <body:Statement*> => SwitchCase { enum_name: Some(enum_name), variant: Some(variant), bindings, body },
    "case" <enum_name:ID> "::" <variant:ID> ":" <body:Statement*> => SwitchCase { enum_name: Some(enum_name), variant: Some(variant), bindings: vec![], body }
};

BindingList: Vec<String> = {
    => vec![],
    <first:ID> <rest:("," <ID>)*> => { let mut bindings = vec![first]; bindings.extend(rest); bindings }
};

VariableDeclaration: VariableDeclaration = {
    "let" <spec:DeclarationSpec> <name:ID> "=" <value:Expression> ";" =>
        VariableDeclaration { name, mutability: spec.0, ty: spec.1, value }
};

DisplayArguments: Vec<Expression> = {
    => vec![],
    <first:Expression> <rest:("," <Expression>)*> => {
        let mut arguments = vec![first];
        arguments.extend(rest);
        arguments
    }
};

Expression: Expression = LogicalOr;

LogicalOr: Expression = {
    <left:LogicalOr> "||" <right:LogicalAnd> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::LogicalOr, right: Box::new(right) },
    LogicalAnd,
};

LogicalAnd: Expression = {
    <left:LogicalAnd> "&&" <right:BitOr> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::LogicalAnd, right: Box::new(right) },
    BitOr,
};

BitOr: Expression = {
    <left:BitOr> "|" <right:BitXor> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::BitOr, right: Box::new(right) },
    BitXor,
};

BitXor: Expression = {
    <left:BitXor> "^" <right:BitAnd> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::BitXor, right: Box::new(right) },
    BitAnd,
};

BitAnd: Expression = {
    <left:BitAnd> "&" <right:Equality> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::BitAnd, right: Box::new(right) },
    Equality,
};

Equality: Expression = {
    <left:Comparison> "==" <right:Comparison> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::Equal, right: Box::new(right) },
    <left:Comparison> "!=" <right:Comparison> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::NotEqual, right: Box::new(right) },
    Comparison,
};

Comparison: Expression = {
    <left:Shift> ">=" <right:Shift> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::GreaterEqual, right: Box::new(right) },
    <left:Shift> "<=" <right:Shift> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::LessEqual, right: Box::new(right) },
    <left:Shift> ">" <right:Shift> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::Greater, right: Box::new(right) },
    <left:Shift> "<" <right:Shift> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::Less, right: Box::new(right) },
    Shift,
};

Shift: Expression = {
    <left:Shift> "<<" <right:Additive> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::ShiftLeft, right: Box::new(right) },
    <left:Shift> ">>" <right:Additive> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::ShiftRight, right: Box::new(right) },
    Additive,
};

Additive: Expression = {
    <left:Additive> "+" <right:Multiplicative> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::Add, right: Box::new(right) },
    <left:Additive> "-" <right:Multiplicative> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::Subtract, right: Box::new(right) },
    Multiplicative,
};

Multiplicative: Expression = {
    <left:Multiplicative> "*" <right:Unary> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::Multiply, right: Box::new(right) },
    <left:Multiplicative> "/" <right:Unary> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::Divide, right: Box::new(right) },
    <left:Multiplicative> "%" <right:Unary> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::Remainder, right: Box::new(right) },
    Unary,
};

Unary: Expression = {
    "!" <expression:Unary> => Expression::Unary { operator: UnaryOperator::Not, expression: Box::new(expression) },
    "-" <expression:Unary> => Expression::Unary { operator: UnaryOperator::Negate, expression: Box::new(expression) },
    "~" <expression:Unary> => Expression::Unary { operator: UnaryOperator::BitNot, expression: Box::new(expression) },
    Power,
};

Power: Expression = {
    <left:Primary> "**" <right:Unary> => Expression::Binary { left: Box::new(left), operator: BinaryOperator::Power, right: Box::new(right) },
    Primary,
};

Primary: Expression = {
    <value:Literal> => Expression::Literal(value),
    <introspection:Introspection> => introspection,
    <if_expression:IfExpression> => if_expression,
    <call:FunctionCall> => call,
    "(" <expression:Expression> ")" => expression,
    "[" <values:DisplayArguments> "]" => Expression::Array(values),
    <name:ID> "::" "default" "(" ")" => Expression::DefaultStruct(name),
    <name:ID> "::" <variant:ID> "(" <payload:DisplayArguments> ")" => Expression::EnumVariant { name, variant, payload },
    <name:ID> "::" <variant:ID> => Expression::EnumVariant { name, variant, payload: vec![] },
    <name:ID> "{" <fields:StructInitializerFields> "}" => Expression::StructLiteral { name, fields },
    <value:Primary> "." <name:ID> => Expression::Field { value: Box::new(value), name },
    <array:Primary> "[" <index:Expression> "]" => Expression::Index { array: Box::new(array), index: Box::new(index) },
    <name:ID> => Expression::Variable(name),
};

StructInitializerFields: Vec<(String, Expression)> = {
    => vec![],
    <first:StructInitializerField> <rest:("," <StructInitializerField>)*> => { let mut fields = vec![first]; fields.extend(rest); fields }
};

StructInitializerField: (String, Expression) = {
    <name:ID> ":" <value:Expression> => (name, value)
};

FunctionCall: Expression = {
    <name:ID> "(" <arguments:DisplayArguments> ")" => Expression::Call { name, arguments },
};

IfExpression: Expression = {
    "if" "(" <condition:Expression> ")" "{" <then_value:Expression> "}" "else" "{" <else_value:Expression> "}" =>
        Expression::If { condition: Box::new(condition), then_value: Box::new(then_value), else_value: Box::new(else_value) }
};

Introspection: Expression = {
    "type_of" "(" <argument:IntrospectionArgument> ")" => Expression::Introspection { kind: IntrospectionKind::Type, argument: Box::new(argument) },
    "sign_of" "(" <argument:IntrospectionArgument> ")" => Expression::Introspection { kind: IntrospectionKind::Sign, argument: Box::new(argument) },
    "bit_size_of" "(" <argument:IntrospectionArgument> ")" => Expression::Introspection { kind: IntrospectionKind::BitSize, argument: Box::new(argument) },
    "is_mut" "(" <argument:IntrospectionArgument> ")" => Expression::Introspection { kind: IntrospectionKind::IsMut, argument: Box::new(argument) },
    "identity_of" "(" <argument:IntrospectionArgument> ")" => Expression::Introspection { kind: IntrospectionKind::Identity, argument: Box::new(argument) },
};

IntrospectionArgument: Expression = {
    <name:ID> => Expression::Variable(name),
    <value:Literal> => Expression::Literal(value),
    <introspection:Introspection> => introspection,
};

TypeSpec: VariableType = {
    "bool" => VariableType::Bool,
    "string" => VariableType::String { bits: 16 },
    "float" => VariableType::Float { bits: 32 },
    <sign:("unsigned" ".")?> <bits:BitWidth> <suffix:("." <ScalarSuffix>)?> => match suffix {
        Some(ScalarSuffix::Float) => VariableType::Float { bits },
        Some(ScalarSuffix::String) => VariableType::String { bits },
        Some(ScalarSuffix::Bool) => VariableType::Bool,
        None => VariableType::Integer { bits, unsigned: sign.is_some() },
    },
    <name:ID> => VariableType::Named(name),
};

DeclarationSpec: (Mutability, VariableType) = {
    => (Mutability::Mutable, VariableType::Inferred),
    "." <mutability:Mutability> "." "bool" => (mutability, VariableType::Bool),
    "." <mutability:Mutability> <unsigned:("." "unsigned")?> "." <bits:BitWidth> <suffix:("." <ScalarSuffix>)?> =>
        match suffix {
            Some(ScalarSuffix::Float) => (mutability, VariableType::Float { bits }),
            Some(ScalarSuffix::String) => (mutability, VariableType::String { bits }),
            Some(ScalarSuffix::Bool) => (mutability, VariableType::Bool),
            None => (mutability, VariableType::Integer { bits, unsigned: unsigned.is_some() }),
        }
    , "." <mutability:Mutability> "." "array" "[" <capacity:r"[0-9]+"> "]" <unsigned:("." "unsigned")?> "." <bits:BitWidth> <suffix:("." <ScalarSuffix>)?> => {
        let element = match suffix {
            Some(ScalarSuffix::Float) => VariableType::Float { bits },
            Some(ScalarSuffix::String) => VariableType::String { bits },
            Some(ScalarSuffix::Bool) => VariableType::Bool,
            None => VariableType::Integer { bits, unsigned: unsigned.is_some() },
        };
        (mutability, VariableType::Array { element: Box::new(element), capacity: usize::from_str(capacity).unwrap(), dynamic: false })
    }
    , "." <mutability:Mutability> "." "array" "[" "?" "max" <capacity:r"[0-9]+"> "]" <unsigned:("." "unsigned")?> "." <bits:BitWidth> <suffix:("." <ScalarSuffix>)?> => {
        let element = match suffix {
            Some(ScalarSuffix::Float) => VariableType::Float { bits },
            Some(ScalarSuffix::String) => VariableType::String { bits },
            Some(ScalarSuffix::Bool) => VariableType::Bool,
            None => VariableType::Integer { bits, unsigned: unsigned.is_some() },
        };
        (mutability, VariableType::Array { element: Box::new(element), capacity: usize::from_str(capacity).unwrap(), dynamic: true })
    }
    , "." <mutability:Mutability> "." "array" "[" <capacity:r"[0-9]+"> "]" "." <name:ID> => (mutability, VariableType::Array { element: Box::new(VariableType::Named(name)), capacity: usize::from_str(capacity).unwrap(), dynamic: false })
    , "." <mutability:Mutability> "." "array" "[" "?" "max" <capacity:r"[0-9]+"> "]" "." <name:ID> => (mutability, VariableType::Array { element: Box::new(VariableType::Named(name)), capacity: usize::from_str(capacity).unwrap(), dynamic: true })
    , "." <mutability:Mutability> "." <name:ID> => (mutability, VariableType::Named(name))
};

Mutability: Mutability = {
    "mut" => Mutability::Mutable,
    "const" => Mutability::Constant,
};

BitWidth: u8 = {
    "8bit" => 8,
    "16bit" => 16,
    "32bit" => 32,
};

ScalarSuffix: ScalarSuffix = {
    "float" => ScalarSuffix::Float,
    "string" => ScalarSuffix::String,
    "bool" => ScalarSuffix::Bool,
};

Literal: Literal = {
    <n:r"[0-9]+\.[0-9]+"> => Literal::Float(f64::from_str(n).unwrap()),
    <n:r"[0-9]+"> => Literal::Integer(i64::from_str(n).unwrap()),
    <s:r#"\"[^\"]*\""#> => Literal::String(s[1..s.len() - 1].to_string()),
    "true" => Literal::Bool(true),
    "false" => Literal::Bool(false),
};

StringValue: String = {
    <s:r#"\"[^\"]*\""#> => s[1..s.len() - 1].to_string(),
};

ID: String = {
    <s:r"[a-zA-Z_][a-zA-Z0-9_]*"> => s.to_string(),
};
